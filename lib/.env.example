# Capsule Cinema environment template
# Copy to repository root `.env` for local use. Do not commit real secrets.

# === Runtime paths ===
PYTHON_BIN=python3.12
DOTENV_PATH=/absolute/path/to/capsule-cinema/.env
VIDEO_RESOURCES_PATH=/absolute/path/to/capsule-cinema/lib/video_resources
OPENCLAW_OUTPUT_DIR=/absolute/path/to/capsule-cinema/output/openclaw_runs
VIDEO_CAPSULE_DB=~/.codex/video-production/capsules.sqlite

# === Planning LLM ===
CREW_API_KEY=
CREW_BASE_URL=
CREW_MODEL_NAME=gemini-3.1-pro-preview
CREW_MAX_TOKEN=65535

# === Juling image/video ===
JULING_BASE_URL=
JULING_API_KEY=
JULING_VEO31_MODEL=veo3.1_fast
GROK_VIDEO_BASE_URL=
GROK_VIDEO_API_KEY=

# === OpenAI image / Ark video ===
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_BASE_URL=https://api.openai.com/v1
GPT_IMAGE2_EDIT_BASE_URL=https://api.openai.com/v1
ZEAKAI_GPT_IMAGE2_PRO_API_KEY=
ZEAKAI_GPT_IMAGE2_PRO_BASE_URL=
ZEAKAI_GPT_IMAGE2_PRO_EDIT_BASE_URL=
ZEAKAI_GPT_IMAGE2_PRO_MODEL=gpt-image-2-pro
ZEAKAI_GPT_IMAGE2_PRO_QUALITY=high
ZEAKAI_BASE_URL=
ZEAKAI_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_SEEDANCE20_MODEL=
SEEDANCE20_MODEL=
SEEDANCE20_DEFAULT_DURATION=5s

# === Veo ===
VEO3_BASE_URL=
VEO3_API_KEY=
VEO3_MODEL=veo3.1
VEO_ACCESS_TOKEN=

# === Gemini image and analysis ===
GEMINI3_API_KEY=
GEMINI3_BASE_URL=
GEMINI3_MODEL_NAME=gemini-3.1-pro-preview
GEMINI3_PRO_BASE_URL=
GEMINI3_PRO_API_KEY=
USE_GEMINI3_VIDEO_ANALYZER=true
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_BASE_URL=
VIDEO_ANALYSIS_MODEL_NAME=gemini-2.5-pro
VIDEO_ANALYSIS_TIMEOUT_SECONDS=180

# === TTS ===
DOUBAO_TTS_APPID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_SECRET_KEY=
DOUBAO_TTS_CLUSTER_ID=volcano_tts
DOUBAO_ARK_API_KEY=
MINIMAX_API_KEY=

# === Music ===
SUNO_BASE_URL=
SUNO_API_KEY=
MUSIC_DEFAULT_FOLDER=/absolute/path/to/capsule-cinema/lib/video_resources/music
JAMENDO_CLIENT_ID=
JAMENDO_API_BASE=https://api.jamendo.com/v3.0
ONLINE_MUSIC_MAX_MB=80
ONLINE_MUSIC_SEARCH_LIMIT=10
ONLINE_MUSIC_REQUEST_TIMEOUT=60
ONLINE_MUSIC_ENABLE_ARCHIVE=true
INTERNET_ARCHIVE_SEARCH_API=https://archive.org/advancedsearch.php
INTERNET_ARCHIVE_METADATA_BASE=https://archive.org/metadata
INTERNET_ARCHIVE_DOWNLOAD_BASE=https://archive.org/download

# === RunningHub ===
RUNNINGHUB_API_KEY=
WANANIMATE2_API_KEY=
WANANIMATE2_WEBAPP_ID=
WAN22_API_KEY=
WAN22_WEBAPP_ID=

# === Moderation and multimodal ===
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
MODERATION_API_KEY=
MODERATION_BASE_URL=
MODERATION_MODEL_NAME=deepseek-chat
OPENAI_BASE_URL=
OPENAI_API_KEY=
